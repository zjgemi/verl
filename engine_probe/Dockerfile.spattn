# verl training image + Ulysses-SP fix for Qwen3.5 full-attention layers.
#
# Stock verl installs the ulysses all-to-all only into
# transformers.integrations.flash_attention._flash_attention_forward, which is
# dead code under attn_implementation=sdpa (what our run script forces). Each
# rank then attends only inside its own contiguous 1/sp slice of the sequence:
# a silent correctness bug in the 8/32 full_attention layers, not a precision one.
#
# The fix also has to rebuild the packing boundaries after the all-to-all: HF's
# block-causal mask is built from the LOCAL shard and is meaningless once the
# sequence is gathered, and a global dense mask would be total_nnz**2 (~16 GB at
# 126k tokens). So attention runs per cu_seqlens segment with is_causal=True.
#
# CPU repro + verification: engine_probe/test_sp_sdpa_attention.py
#   before: shard0 rel_l2 = 0.0 (self-contained), shard1 rel_l2 = 3.7e-01
#   after : every shard rel_l2 <= 8e-08 (0.0 when segments align with shards)
FROM registry.dp.tech/dptech/dp/native/prod-1760009/11106/verl-coding:202608292148

RUN echo "" | base64 -d > /opt/patch_qwen3_5_sp_attn.py \
 && python3 /opt/patch_qwen3_5_sp_attn.py \
 && python3 /opt/patch_qwen3_5_sp_attn.py --check
