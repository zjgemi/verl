# verl training image + fla context-parallel affine-chain precision knob.
#
# Adds FLA_CP_PRECISION={ieee,tf32x3,tf32} to fla/ops/cp/chunk_delta_h.py.
# Default 'tf32' reproduces upstream 0.5.1 bit-for-bit, so one image serves as
# both control and treatment arm -- the image itself is not a confounder.
# See engine_probe/patch_fla_cp_precision.py and fla PR #1180.
FROM registry.dp.tech/dptech/dp/native/prod-1760009/11106/verl-coding:202608292148

RUN echo "" | base64 -d > /opt/patch_fla_cp_precision.py \
 && python3 /opt/patch_fla_cp_precision.py \
 && python3 /opt/patch_fla_cp_precision.py --check \
 && python3 -c "import fla.ops.cp.chunk_delta_h as m; print('constexpr:', m.FLA_CP_PRECISION, 'str:', m.FLA_CP_PRECISION_STR)"
